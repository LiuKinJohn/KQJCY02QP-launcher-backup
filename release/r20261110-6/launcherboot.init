#!/bin/sh /etc/rc.common
# S98: the factory UI, UDISK mount and ADB have already started.
# The UDISK mount may still be pending when procd invokes this script.
if [ "$1" = --wait ]; then
    BASE=/mnt/UDISK/launcher/autoboot
    count=0
    while [ "$count" -lt 90 ]; do
        if mount | grep -q ' on /mnt/UDISK type '; then
            [ -f "$BASE/enabled" ] || exit 0
            GUARD=$BASE/current/guard.sh
            [ -r "$GUARD" ] || exit 0
            HASH=$(md5sum "$GUARD" | cut -d ' ' -f 1)
            [ "$HASH" = 15caa18f3df9a8b0e1fd3ef7f73897ef ] ||
            [ "$HASH" = a7ffe4e8643a94c477f65ef83170f0db ] || exit 0
            exec /bin/sh "$GUARD"
        fi
        sleep 1
        count=$((count + 1))
    done
    echo 'launcherboot: UDISK mount timeout; factory startup continues' >> /tmp/launcherboot.log
    exit 0
fi

START=98
STOP=99
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh /etc/init.d/launcherboot --wait
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
